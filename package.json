{
  "name": "truflake",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --env-file-if-exists=.env.local --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@upstash/redis": "^1.36.1",
    "remix": "3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
